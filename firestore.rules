rules_version = '2';

// Casa Urban — chaque utilisateur ne voit et ne modifie que ses propres scénarios.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/scenarios/{scenarioId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.id == scenarioId
        && request.resource.data.parcelleId is string
        && request.resource.data.updatedAt is number
        && request.resource.data.input is map;
    }
    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
