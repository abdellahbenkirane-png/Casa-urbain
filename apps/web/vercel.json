{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && npm install && npm --workspace @casa/web run build",
  "outputDirectory": "dist",
  "installCommand": "echo skip-install",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!assets/|data/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
