# Configuration web Firebase (Console Firebase → Paramètres du projet → Vos applications → Web).
# Ces valeurs ne sont pas secrètes : elles identifient le projet, la sécurité
# repose sur les règles Firestore (firestore.rules).
# Copier ce fichier en .env.local pour tester en local, et ajouter les mêmes
# variables dans Vercel (Settings → Environment Variables) pour la production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
